# Modelo, não credenciais reais. Configure os valores nos painéis, por ambiente.
# A web funciona sem chave de IA; o provedor e seus segredos pertencem ao worker.
NEXT_PUBLIC_APP_URL=https://seu-dominio.example
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Controlador Modal v2, nunca o runner local.
MODAL_JUDGE_ENDPOINT=
MODAL_JUDGE_TOKEN=
SILOGIUM_ALLOW_LOCAL_EXECUTION=false

# Habilitar somente depois de escolher/configurar o provedor e testar o worker.
SILOGIUM_AUTHORING_ENABLED=false

# NÃO preencher para simplesmente desbloquear conquistas: exige auditoria real.
SILOGIUM_VERIFIED_JUDGE_POLICY=

# Apenas no processo administrativo do seed, não no bundle web:
SILOGIUM_PRIVATE_BUNDLES_DIR=

# Apenas no worker, caso OpenAI seja o provedor escolhido posteriormente:
# NODE_ENV=production
# SILOGIUM_AUTHORING_ENABLED=true
# SILOGIUM_AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_AUTHORING_MODEL=<modelo-disponivel-no-projeto>
# OPENAI_DISCOVERY_MODEL=<modelo-disponivel-no-projeto>
