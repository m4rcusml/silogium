# Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA — somente Groq; local é um simulador determinístico para testes sem rede.
# Copie para apps/web/.env.local. Nunca versione a chave.
SILOGIUM_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_AUTHORING_MODEL=openai/gpt-oss-120b
# Experimental. A pesquisa no catálogo não depende desta opção.
GROQ_WEB_SEARCH_ENABLED=false

# Judge remoto
MODAL_JUDGE_ENDPOINT=
MODAL_JUDGE_TOKEN=
# Só definir após validar isolamento do judge/bundles oficiais; não habilitar na demo.
SILOGIUM_VERIFIED_JUDGE_POLICY=
SILOGIUM_ALLOW_LOCAL_EXECUTION=true

# Com Supabase, inclusive em desenvolvimento, a autoria usa a fila e worker separado.
# Sem Supabase, o simulador em memória continua integrado.
# Habilite apenas após validar beta, worker, capacidade e limites financeiros.
SILOGIUM_AUTHORING_ENABLED=false
# Web: notificação autenticada após o commit. Não colocar em NEXT_PUBLIC_*.
SILOGIUM_WORKER_WAKE_URL=
SILOGIUM_WORKER_WAKE_TOKEN=
# Controlador Modal: confirma a identidade do workspace antes de observar consumo.
SILOGIUM_MODAL_WORKSPACE=

# Seed/validação: caminho externo ao repositório para testes realmente privados.
SILOGIUM_PRIVATE_BUNDLES_DIR=

# CLI
SILOGIUM_API_URL=http://localhost:3000/api/v1
