# Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA — Codex usa o login local do ChatGPT; local usa o simulador determinístico
SILOGIUM_AI_PROVIDER=codex
CODEX_AUTHORING_MODEL=gpt-5.6-terra
CODEX_DISCOVERY_MODEL=gpt-5.6-luna
CODEX_TIMEOUT_MS=600000

# OpenAI — nunca exponha estas variáveis no navegador
OPENAI_API_KEY=
OPENAI_DISCOVERY_MODEL=gpt-5.6-luna
OPENAI_AUTHORING_MODEL=gpt-5.6-terra

# Judge remoto
MODAL_JUDGE_ENDPOINT=
MODAL_JUDGE_TOKEN=
# Só definir após validar isolamento do judge/bundles oficiais; não habilitar na demo.
SILOGIUM_VERIFIED_JUDGE_POLICY=
SILOGIUM_ALLOW_LOCAL_EXECUTION=true

# CLI
SILOGIUM_API_URL=http://localhost:3000/api/v1
