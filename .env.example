# Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA — somente Groq; local é um simulador determinístico para testes sem rede.
# Copie para apps/web/.env.local. Nunca versione a chave.
SILOGIUM_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_AUTHORING_MODEL=openai/gpt-oss-120b
# Experimental. Catálogo e Exercism continuam funcionando quando false.
GROQ_WEB_SEARCH_ENABLED=false

# Judge remoto
MODAL_JUDGE_ENDPOINT=
MODAL_JUDGE_TOKEN=
# Só definir após validar isolamento do judge/bundles oficiais; não habilitar na demo.
SILOGIUM_VERIFIED_JUDGE_POLICY=
SILOGIUM_ALLOW_LOCAL_EXECUTION=true

# Em produção/preview a autoria é opt-in e processada pelo worker durável.
# Ausente/false não desabilita o desenvolvimento local atual.
SILOGIUM_AUTHORING_ENABLED=false

# Seed/validação: caminho externo ao repositório para testes realmente privados.
SILOGIUM_PRIVATE_BUNDLES_DIR=

# CLI
SILOGIUM_API_URL=http://localhost:3000/api/v1
