{
  "name": "silogium",
  "version": "0.2.0",
  "private": true,
  "description": "Plataforma para descobrir, resolver e avaliar problemas de programação.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "assessment": "node scripts/assessment.mjs",
    "open": "code .",
    "content:generate": "node scripts/generate-content.mjs",
    "db:seed": "npm run content:generate && tsx scripts/seed-supabase.mjs",
    "content:private": "tsx scripts/generate-private-classics.ts",
    "deploy:check": "tsx scripts/check-deployment.ts",
    "worker": "tsx infra/worker/run.ts",
    "worker:check": "tsx infra/worker/run.ts --check",
    "test:judge:controller": "python -m unittest discover -s infra/modal -p test_*.py -v",
    "test:production-guard": "node scripts/smoke-production-guard.mjs",
    "test:private-references": "node scripts/verify-private-references.mjs",
    "test:private-bundles": "npm run content:generate && tsx scripts/verify-private-bundles.ts",
    "dev": "npm run dev --workspace @silogium/web",
    "build": "npm run content:generate && npm run build --workspaces --if-present",
    "test": "npm run content:generate && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "npx supabase test db",
    "test:groq": "tsx scripts/evaluate-groq.ts",
    "typecheck": "npm run content:generate && npm run typecheck --workspaces --if-present",
    "cli": "tsx packages/cli/src/index.ts",
    "test:q1:ts": "tsx grader/typescript/run.ts q1 visible",
    "grade:q1:ts": "tsx grader/typescript/run.ts q1 grade 4",
    "test:q2:ts": "tsx grader/typescript/run.ts q2 visible",
    "grade:q2:ts": "tsx grader/typescript/run.ts q2 grade 4",
    "test:q3:ts": "tsx grader/typescript/run.ts q3 visible",
    "grade:q3:ts": "tsx grader/typescript/run.ts q3 grade 4",
    "test:q1:py": "python grader/python/run.py q1 visible",
    "grade:q1:py": "python grader/python/run.py q1 grade 4",
    "test:q2:py": "python grader/python/run.py q2 visible",
    "grade:q2:py": "python grader/python/run.py q2 grade 4",
    "test:q3:py": "python grader/python/run.py q3 visible",
    "grade:q3:py": "python grader/python/run.py q3 grade 4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0"
  }
}
